{
  "name": "type-safe-client-gen",
  "version": "0.0.0",
  "description": "Generate type-safe HTTP clients from OpenAPI specifications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tscg": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target node && bun build src/index.ts --outdir dist --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun run typecheck"
  },
  "keywords": [
    "openapi",
    "swagger",
    "codegen",
    "typescript",
    "api-client",
    "type-safety"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "bun-types": "^1.3.13"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}